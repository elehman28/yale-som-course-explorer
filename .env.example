# Copy to .env (this folder, or the parent folder) and fill in.
# Never commit the real .env.

PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: override the Portkey gateway URL
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Leave unset to use the local SQLite file at data/yale_som.db.
# Set to your Supabase connection string to use Postgres instead.
# Supabase: Project Settings -> Database -> Connection string -> URI
# (use the pooled connection on port 6543 for serverless/deployed apps).
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
